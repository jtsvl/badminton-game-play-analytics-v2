+# ── LOCAL MPS PATCH (worker/training/tracknetv5_finetune.md) ──────────────────────────────────────
+# Upstream hard-codes .cuda() and bf16 autocast (CUDA-only); on the Mac Studio PYTORCH_ENABLE_MPS_FALLBACK
+# only redirects unimplemented ops, NOT explicit .cuda(). Route the trainer through a global DEVICE
+# (mps→cpu, fp32, no autocast/GradScaler off CUDA) and load checkpoints with weights_only=True
+# (allow-listing only the numpy scalar/dtype the release files pickle), mirroring
+# worker/shuttle/tracknetv5.py + the V3 patch. Scope = train.py (+ eval_tracknet in test.py).
+def pick_device(prefer='auto'):
+    if prefer == 'cpu':
+        return 'cpu'
+    if prefer == 'cuda' and torch.cuda.is_available():
+        return 'cuda'
+    if prefer in ('auto', 'mps') and torch.backends.mps.is_available():
+        return 'mps'
+    if prefer == 'auto' and torch.cuda.is_available():
+        return 'cuda'
+    return 'cpu'
+
+
+def _safe_load(path):
+    """torch.load with weights_only=True; the only non-torch globals in the release checkpoints are the
+    numpy scalar/dtype of `val_f1` — allow-list exactly those, never fall back to weights_only=False."""
+    import importlib
+    import numpy as np
+    allowed = [np.dtype]
+    scalar = None
+    for modname in ('numpy._core.multiarray', 'numpy.core.multiarray'):
+        try:
+            scalar = importlib.import_module(modname).scalar
+            break
+        except (ImportError, AttributeError):
+            pass
+    if scalar is not None:
+        allowed.append(scalar)
+        for legacy in ('numpy.core.multiarray.scalar', 'numpy._core.multiarray.scalar'):
+            if legacy != f'{scalar.__module__}.{scalar.__qualname__}':
+                allowed.append((scalar, legacy))   # numpy>=2 pickles the legacy name (torch>=2.6 tuple form)
+    try:
+        import numpy.dtypes as npd
+        allowed.extend(getattr(npd, n) for n in dir(npd) if n.endswith('DType'))
+    except ImportError:
+        pass
+    with torch.serialization.safe_globals(allowed):
+        return torch.load(path, map_location='cpu', weights_only=True)
+
+
+DEVICE = pick_device(getattr(ARGS, 'device', 'auto'))
+AMP_ENABLED = DEVICE == 'cuda'          # fp32 on MPS/CPU (CLAUDE.md: MPS fp32, validate vs CPU for NaNs)
+print(f'  device {DEVICE}  autocast {"on" if AMP_ENABLED else "off (fp32)"}', flush=True)
+# ──────────────────────────────────────────────────────────────────────────────────────────────────
+
 
