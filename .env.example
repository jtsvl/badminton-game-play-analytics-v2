# ─────────────────────────────────────────────────────────────────────────────
# Badminton Analytics — environment template. Copy to .env and fill in.
# Supabase is SELF-HOSTED on Coolify (not supabase.com). Use that instance's
# URL and keys. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (self-hosted on Coolify) ---
SUPABASE_URL=https://supabase.your-coolify-host.example
SUPABASE_ANON_KEY=replace-me-anon
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role   # worker only — full access, keep secret
SUPABASE_DB_URL=postgresql://postgres:password@db-host:5432/postgres  # for migrations / direct SQL

# --- Storage ---
SUPABASE_VIDEO_BUCKET=match-videos
SUPABASE_ARTIFACT_BUCKET=analysis-artifacts

# --- Web app (Vite needs the VITE_ prefix; only public keys here) ---
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# --- Worker (Mac Studio, Apple Silicon) ---
WORKER_ID=mac-studio-1
PYTORCH_ENABLE_MPS_FALLBACK=1
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_FRAME_CACHE_DIR=./worker/.cache
